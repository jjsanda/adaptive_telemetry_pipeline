# Copy to .env for local runs. The stack is designed to run fully OFFLINE with
# zero API keys — everything below is OPTIONAL.

# --- llmtriage connector: LLM backend selection ---
# Backend: "deterministic" (default, offline, no key) or "anthropic".
ADAPTIVE_LLM_BACKEND=deterministic
# Only used when ADAPTIVE_LLM_BACKEND=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
# Model id for the Anthropic backend (see docs/adr and the claude-api reference).
ADAPTIVE_LLM_MODEL=claude-sonnet-5

# --- Optional webhook for triage summaries (e.g. Slack incoming webhook) ---
ADAPTIVE_TRIAGE_WEBHOOK_URL=
